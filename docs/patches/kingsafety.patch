+        let mut attacked = 0;
+        let mut empty = 0;
+        for d in 0..8 {
+            if t.ray_len[k][d] == 0 {
+                continue;
+            }
+            let sq = t.ray[k][d][0] as usize;
+            let p = pos.board[sq];
+            if p == EMPTY {
+                empty += 1;
+            }
+            if (p == EMPTY || color_of(p) == c) && pos.is_attacked(sq, c ^ 1) {
+                attacked += 1;
+            }
+        }
+        f(c, IDX_KING_ADJ_ATK + attacked, 1);
+        let enemy_hand: i32 = (2..8).map(|pt| pos.hand[c ^ 1][pt] as i32).sum();
+        if empty * enemy_hand > 0 {
+            f(c, IDX_KING_EMPTY_HAND, empty * enemy_hand);
+        }
+    }
