+    /// 1手詰めがあればその手を返す（敵玉の近く=チェビシェフ距離2以内に指す/打つ手だけを調べる）
+    fn mate1(&mut self, pos: &mut Position) -> Option<Move> {
+        let them = pos.side ^ 1;
+        let ksq = pos.king_sq[them];
+        let (kr, kc) = ((ksq / 9) as i32, (ksq % 9) as i32);
+        let mut moves = Vec::with_capacity(160);
+        pos.pseudo_moves(&mut moves, false);
+        for &m in moves.iter() {
+            let to = mv_to(m);
+            let (tr, tc) = ((to / 9) as i32, (to % 9) as i32);
+            if (tr - kr).abs() > 2 || (tc - kc).abs() > 2 {
+                continue;
+            }
+            if mv_is_drop(m) && mv_drop_pt(m) == PAWN {
+                continue; // 打ち歩詰めは反則
+            }
+            if !self.try_move(pos, m) {
+                continue;
+            }
+            let mate = pos.in_check() && !pos.has_legal_move();
+            pos.undo_move();
+            if mate {
+                return Some(m);
+            }
+        }
+        None
+    }
+
     fn qsearch(&mut self, pos: &mut Position, ply: usize, mut alpha: i32, beta: i32, qdepth: i32) -> i32 {
